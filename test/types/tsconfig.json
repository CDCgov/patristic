{
  // Compile-only checks of the published declarations, resolved through the
  // package's own exports the way a TypeScript project using it would.
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": [],
    "strict": true,
    "noEmit": true
  },
  "include": ["*.mts", "*.cts"]
}
